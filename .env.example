# Clicky Desktop — API Keys
# These vars belong in backend/.env, not the repo root.
# Copy backend/.env.example to backend/.env and fill in your keys.

# Required for voice transcription (Nova-3) and TTS (Aura-2) — https://deepgram.com
DEEPGRAM_API_KEY=

# Required for LLM vision + computer use (Nemotron Omni) — https://openrouter.ai
OPENROUTER_API_KEY=

# Optional: Deepgram Aura-2 voice model (default: aura-2-thalia-en)
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
